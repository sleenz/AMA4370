{
  "_comment": "Configuration for wallet trading system",

  "etherscan_api_key": "YOUR_ETHERSCAN_API_KEY",
  "etherscan_api_url": "https://api.etherscan.io/v2/api",
  "chainid": 1,
  "rate_limit": 5.0,

  "web3_provider_uri": "https://eth.llamarpc.com",
  "coingecko_api_key": "YOUR_COINGECKO_API_KEY_OPTIONAL",

  "total_capital_usd": 100000,
  "trade_multiplier": 0.5,
  "max_leverage": 25,

  "max_spread_pct": 0.5,
  "min_depth_multiplier": 10,

  "max_total_positions": 20,
  "max_same_pair_positions": 3,
  "max_position_pct": 5.0,
  "max_total_risk_pct": 50.0,

  "exchanges": {
    "binance": {
      "api_key": "YOUR_BINANCE_API_KEY",
      "api_secret": "YOUR_BINANCE_API_SECRET",
      "testnet": false
    },
    "bybit": {
      "api_key": "YOUR_BYBIT_API_KEY",
      "api_secret": "YOUR_BYBIT_API_SECRET",
      "testnet": false
    }
  }
}
